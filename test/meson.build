if smpl_features_enabled
  hardening_python = find_program('python3')
  hardening_runner = files('run-isolated-regression.py')
  copy_integrity_schemas = custom_target('copy-integrity-schemas',
    input: '../libnemo-private/org.nemo.gschema.xml',
    output: 'gschemas.compiled',
    command: [
      find_program('glib-compile-schemas'),
      '--strict',
      '--targetdir', '@OUTDIR@',
      meson.project_source_root() / 'libnemo-private',
    ],
  )

  test('MTP empty folder state', hardening_python,
    args: hardening_runner + [hardening_python.full_path(), files('test-mtp-empty.py')[0]],
    suite: 'mtp-state',
    timeout: 60,
  )

  test('Icon fallback inventory', hardening_python,
    args: files('test-icon-inventory.py'),
    suite: 'icons',
  )
  icon_fallback_test = executable('test-icon-fallback',
    'test-icon-fallback.c',
    include_directories: [rootInclude],
    dependencies: [gtk, nemo_private],
    c_args: nemo_definitions,
    link_args: ['-Wl,--wrap=gtk_icon_theme_has_icon'],
  )
  test('Embedded icon fallbacks', hardening_python,
    args: hardening_runner + [icon_fallback_test],
    suite: 'icons',
    timeout: 60,
  )

  test('Sidebar async hardening', hardening_python,
    args: files('test-sidebar-async.py'),
    suite: 'hardening',
    timeout: 60,
  )

  completion_test = executable('test-progress-completion',
      ['test-progress-completion.c', '../src/nemo-progress-info-widget.c'],
      include_directories: [rootInclude],
      dependencies: [gtk, xapp, nemo_private],
      c_args: nemo_definitions,
  )
  test('Completion real backends', hardening_python,
    args: hardening_runner + [completion_test, '--real-backends'],
    env: {'GSETTINGS_SCHEMA_DIR': meson.current_build_dir()},
    depends: copy_integrity_schemas,
    suite: 'hardening',
    timeout: 60,
    is_parallel: false,
  )
  test('Completion pending backend exit', hardening_python,
    args: hardening_runner + [completion_test, '--real-pending-exit'],
    env: {'GSETTINGS_SCHEMA_DIR': meson.current_build_dir()},
    depends: copy_integrity_schemas,
    suite: 'hardening',
    timeout: 60,
    is_parallel: false,
  )
  ui_regressions = [
    completion_test,
    executable('test-nemo-file-hierarchy',
      'test-nemo-file-hierarchy.c',
      include_directories: [rootInclude],
      dependencies: [gtk, nemo_private],
    ),
    executable('test-nemo-paged-viewer',
      ['test-nemo-paged-viewer.c', '../src/nemo-preview-utils.c'],
      include_directories: [rootInclude],
      dependencies: nemo_deps,
    ),
    executable('test-nemo-preview-pane-async',
      [
        'test-nemo-preview-pane-async.c',
        '../src/nemo-image-viewer.c',
        '../src/nemo-paged-viewer.c',
        '../src/nemo-preview-utils.c',
      ],
      include_directories: [rootInclude],
      dependencies: nemo_deps,
      c_args: nemo_definitions,
    ),
    executable('test-nemo-preview-async',
      [
        'test-nemo-preview-async.c',
        '../src/nemo-paged-viewer.c',
        '../src/nemo-dir-analyzer.c',
      ],
      include_directories: [rootInclude],
      dependencies: nemo_deps,
      c_args: nemo_definitions,
    ),
    executable('test-nemo-properties-volume',
      [
        'test-nemo-properties-volume.c',
        '../src/nemo-error-reporting.c',
        '../src/nemo-desktop-item-properties.c',
      ],
      include_directories: [rootInclude],
      dependencies: [gtk, nemo_private],
      c_args: nemo_definitions + ['-ffunction-sections', '-fdata-sections'],
      link_args: ['-Wl,--gc-sections'],
    ),
  ]
  foreach regression : ui_regressions
    regression_suites = ['hardening']
    if regression == completion_test
      regression_suites += ['transfer-safety']
    endif
    test(regression.name(), hardening_python,
      args: hardening_runner + [regression],
      env: {'GSETTINGS_SCHEMA_DIR': meson.current_build_dir()},
      depends: copy_integrity_schemas,
      suite: regression_suites,
      timeout: 60,
      is_parallel: false,
    )
  endforeach
endif


test('Search Engine test',
  executable('test-nemo-search-engine',
    [ 'test-nemo-search-engine.c' ],
    include_directories: [ rootInclude, ],
    dependencies: [ gtk, nemo_private ],
  ),
  args: []
)

test('Directory Async test',
  executable('test-nemo-directory-async',
    [ 'test-nemo-directory-async.c' ],
    include_directories: [ rootInclude, ],
    dependencies: [ gtk, nemo_private ],
  ),
  args: []
)

test('Copy test',
  executable('test-nemo-copy',
    [ 'test-copy.c', 'test.c' ],
    include_directories: [ rootInclude, ],
    dependencies: [ gtk, nemo_private ],
    c_args: nemo_definitions,
  ),
  args: []
)

if smpl_features_enabled
  transfer_recovery = executable('test-transfer-recovery',
    ['test-transfer-recovery.c', '../libnemo-private/nemo-transfer-safety.c'],
    include_directories: [rootInclude],
    dependencies: [gio_unix, gtk],
    c_args: nemo_definitions,
    link_args: [
      '-Wl,--wrap=g_uuid_string_random',
      '-Wl,--wrap=statx',
      '-Wl,--wrap=fstatfs',
      '-Wl,--wrap=fstatfs64',
      '-Wl,--wrap=mkdirat',
      '-Wl,--wrap=renameat2',
      '-Wl,--wrap=fsync',
      '-Wl,--wrap=close',
      '-Wl,--wrap=g_unix_mounts_get',
      '-Wl,--wrap=g_unix_mounts_changed_since',
      '-Wl,--wrap=g_get_monotonic_time',
    ],
  )
  test('transfer-safety-recovery-contracts', transfer_recovery,
    env: {'LC_ALL': 'C', 'GIO_USE_VFS': 'local'},
    suite: 'transfer-safety',
    protocol: 'tap',
    timeout: 300,
    is_parallel: false,
  )
  transfer_trash = executable('test-transfer-trash',
    ['test-transfer-trash.c', '../libnemo-private/nemo-transfer-safety.c'],
    include_directories: [rootInclude],
    dependencies: [gio_unix, gtk],
    c_args: nemo_definitions,
  )
  test('transfer-safety-trash-guard', transfer_trash,
    env: {'LC_ALL': 'C', 'GIO_USE_VFS': 'local'},
    suite: 'transfer-safety',
    protocol: 'tap',
  )
  copy_integrity = executable('test-copy-integrity',
    'test-copy-integrity.c',
    include_directories: [ rootInclude ],
    dependencies: [ gtk, nemo_private ],
    c_args: nemo_definitions,
    link_args: [
      '-Wl,--wrap=open',
      '-Wl,--wrap=open64',
      '-Wl,--wrap=openat',
      '-Wl,--wrap=openat64',
      '-Wl,--wrap=mkdirat',
      '-Wl,--wrap=renameat2',
      '-Wl,--wrap=unlinkat',
      '-Wl,--wrap=read',
      '-Wl,--wrap=close',
      '-Wl,--wrap=remove',
      '-Wl,--wrap=fsync',
      '-Wl,--wrap=syncfs',
      '-Wl,--wrap=sync_file_range',
      '-Wl,--wrap=g_file_query_info',
      '-Wl,--wrap=g_file_enumerate_children',
      '-Wl,--wrap=g_file_enumerator_next_file',
      '-Wl,--wrap=g_file_get_path',
      '-Wl,--wrap=g_file_is_native',
      '-Wl,--wrap=g_file_read',
      '-Wl,--wrap=g_file_copy',
      '-Wl,--wrap=g_file_create',
      '-Wl,--wrap=g_file_make_directory',
      '-Wl,--wrap=g_file_make_symbolic_link',
      '-Wl,--wrap=g_output_stream_write_all',
      '-Wl,--wrap=g_output_stream_close',
      '-Wl,--wrap=g_unix_input_stream_new',
      '-Wl,--wrap=g_input_stream_close',
      '-Wl,--wrap=g_input_stream_read',
      '-Wl,--wrap=g_file_copy_attributes',
      '-Wl,--wrap=g_file_move',
      '-Wl,--wrap=g_file_delete',
    ],
  )

  copy_integrity_base_env = {
    'GSETTINGS_SCHEMA_DIR': meson.current_build_dir(),
    'GSETTINGS_BACKEND': 'memory',
    'GIO_USE_VFS': 'local',
    'GDK_BACKEND': 'x11',
    'LC_ALL': 'C',
    'NO_AT_BRIDGE': '1',
    'TMPDIR': meson.current_build_dir(),
  }
  delete_dialog_test = executable('test-delete-dialog',
    'test-delete-dialog.c',
    include_directories: [rootInclude],
    dependencies: [gtk, nemo_private],
    c_args: nemo_definitions,
    link_args: [
      '-Wl,--wrap=gtk_window_present',
      '-Wl,--wrap=nemo_inhibit_power_manager',
    ],
  )
  test('Delete confirmation focus', hardening_python,
    args: hardening_runner + [delete_dialog_test],
    env: copy_integrity_base_env,
    depends: copy_integrity_schemas,
    suite: 'delete-dialog',
    timeout: 60,
    is_parallel: false,
  )
  transfer_safety = executable('test-transfer-safety',
    'test-transfer-safety.c',
    include_directories: [rootInclude],
    dependencies: [gtk, nemo_private],
    c_args: nemo_definitions,
    link_args: [
      '-Wl,--wrap=renameat2',
      '-Wl,--wrap=syscall',
      '-Wl,--wrap=openat',
      '-Wl,--wrap=openat64',
      '-Wl,--wrap=statx',
      '-Wl,--wrap=mkdirat',
      '-Wl,--wrap=fstatfs',
      '-Wl,--wrap=fstatfs64',
      '-Wl,--wrap=fstat64',
      '-Wl,--wrap=fstatat64',
      '-Wl,--wrap=fsync',
      '-Wl,--wrap=syncfs',
      '-Wl,--wrap=close',
      '-Wl,--wrap=read',
      '-Wl,--wrap=unlinkat',
      '-Wl,--wrap=g_file_is_native',
      '-Wl,--wrap=g_file_get_path',
      '-Wl,--wrap=g_file_get_uri',
      '-Wl,--wrap=g_file_has_uri_scheme',
      '-Wl,--wrap=g_file_query_info',
      '-Wl,--wrap=g_file_create',
      '-Wl,--wrap=g_file_copy',
      '-Wl,--wrap=g_output_stream_write_all',
      '-Wl,--wrap=g_output_stream_close',
      '-Wl,--wrap=nemo_mount_operation_is_removing',
      '-Wl,--wrap=nemo_file_undo_info_ext_add_origin_target_pair',
      '-Wl,--wrap=nemo_file_undo_info_ext_add_transfer',
    ],
  )
  foreach scenario : [
    'mandatory-stage', 'default-copy', 'default-copy-file', 'default-duplicate',
    'default-move-consumption', 'explicit-true-consumption',
    'explicit-true-copy-file', 'explicit-true-duplicate', 'explicit-true-move',
    'backend-nfs', 'backend-fuse', 'backend-tmpfs', 'backend-unknown', 'real-tmpfs-destination',
    'remote-destination', 'remote-source-move', 'remote-source-copy', 'trash-source-copy',
    'removal-inflight-copy', 'removal-inflight-move',
    'existing-match-fsync', 'publish-new-file-race', 'publish-new-directory-race',
    'publish-new-symlink-race', 'publish-exchange-race', 'exchange-unsupported',
    'exchange-einval', 'exchange-eopnotsupp',
    'backend-exchange-einval-copy', 'backend-exchange-eopnotsupp-copy',
    'backend-exchange-enosys-copy', 'backend-exchange-einval-native',
    'backend-exchange-eopnotsupp-native', 'backend-exchange-enosys-native',
    'backend-exchange-einval-crossfs', 'backend-exchange-eopnotsupp-crossfs',
    'backend-exchange-enosys-crossfs',
    'publish-eintr', 'publish-eio', 'copy-publish-fsync', 'recovery-fsync',
    'readable-recovery-details', 'copied-recovery-close', 'symlink-syncfs', 'copied-symlink-syncfs',
    'writer-close', 'directory-close',
    'native-file', 'native-undo-roundtrip', 'native-symlink', 'native-directory', 'native-replacement',
    'native-source-fsync', 'native-tree-fsync', 'native-publish-fsync',
    'native-publish-eintr',
    'native-new-file-race', 'native-directory-race', 'native-capture-swap',
    'native-capture-result-eio', 'copied-capture-result-eio', 'copy-publish-result-eio',
    'native-publish-result-eio', 'exchange-result-eio', 'native-exchange-result-eio',
    'copy-publish-result-eintr', 'exchange-result-eintr',
    'copy-final-anchor-close', 'native-final-anchor-close',
    'copied-source-reclaimed', 'copied-source-swap', 'copied-source-capture-failure',
    'copied-source-capture-cancel', 'move-target-prompt-change', 'move-target-copy-change',
    'copied-source-delete-failure', 'copied-source-delete-fsync', 'copied-source-occupied-restore',
    'enqueue-root-swap', 'enqueue-ancestor-swap', 'enqueue-source-parent-swap',
    'enqueue-mount-swap', 'custom-name-tree', 'recovery-finalization',
    'recovery-entry-details', 'history-releases-anchors',
    'large-copy-low-fd', 'large-move-low-fd', 'large-move-low-fd-failure',
    'bulk-copy-recovery-bounded', 'bulk-copy-recovery-preserved',
    'namespace-copy', 'namespace-native-move', 'namespace-copied-move',
    'recovery-undo-check-no-mutation', 'recovery-reserved-container',
    'recovery-group-writable', 'recovery-other-writable',
    'recovery-marker-inode', 'recovery-marker-metadata', 'recovery-marker-content',
    'recovery-record-inode', 'recovery-record-metadata', 'recovery-record-content',
    'recovery-record-nlink', 'recovery-record-uid',
    'recovery-foreign-payload', 'recovery-foreign-child',
    'undo-replacement', 'undo-newer-target', 'undo-newer-source',
    'undo-capture-race', 'undo-restore-race', 'undo-fsync', 'undo-new-child',
    'undo-postcapture-fsync', 'undo-retry-then-postcapture', 'undo-folder-refused',
    'undo-cancel-before-execution', 'undo-cancel-after-capture',
    'undo-native-folder-refused', 'undo-crossfs-refused', 'undo-mixed-file-folder',
    'undo-mixed-folder-file', 'undo-no-record-refused',
    'undo-reopened-root-swap',
    'undo-merged-directory', 'undo-merge-new-subdirectory', 'redo-newer-target',
  ]
    test('transfer-safety-' + scenario, hardening_python,
      args: hardening_runner + [transfer_safety, scenario],
      env: copy_integrity_base_env,
      depends: copy_integrity_schemas,
      suite: 'transfer-safety',
      protocol: 'tap',
      timeout: scenario.startswith('large-') or scenario.startswith('bulk-') ? 180 : 30,
      is_parallel: false,
    )
  endforeach
  copy_selection_test = executable('test-copy-selection',
    'test-copy-selection.c',
    objects: copy_selection_objects,
    include_directories: [rootInclude, include_directories('../src')],
    dependencies: nemo_deps,
    c_args: nemo_definitions,
  )
  test('Copy source selection', hardening_python,
    args: hardening_runner + [copy_selection_test],
    env: copy_integrity_base_env,
    depends: copy_integrity_schemas,
    suite: 'copy-selection',
    timeout: 60,
    is_parallel: false,
  )
  dbus_run_session = find_program('dbus-run-session', required: false)
  xvfb_run = find_program('xvfb-run', required: false)

  if dbus_run_session.found() and xvfb_run.found()
    foreach scenario : [
      'copy', 'verified-copy', 'private-source', 'chunked-copy',
      'crossfs-copy', 'zero-byte-copy', 'zero-advertised-size-copy',
      'short-read-copy', 'short-read-move', 'readback-short-read', 'pull-short-read',
      'metadata-no-version-move', 'source-changed-move', 'cancel-verification',
      'metadata-preserved', 'default-permissions', 'default-permissions-move',
      'pull-copy', 'pull-chunked-copy', 'pull-read-unsupported', 'pull-syncfs-eio', 'pull-syncfs-eintr',
      'pull-subprocess-copy', 'pull-subprocess-unavailable', 'pull-subprocess-move-unavailable',
      'pull-fsync-eio', 'pull-verify-unavailable', 'pull-move-unavailable',
      'pull-failure-cleanup', 'pull-cancel-cleanup',
      'attributes-unsupported', 'attributes-denied', 'attributes-eio',
      'attributes-enospc', 'symlink-attributes-eio',
      'samefs-move', 'fallback-move', 'real-crossfs-move',
      'replace-corrupt', 'skip-all', 'metadata-unknown', 'readback-unavailable',
      'writer-eio', 'writer-enospc', 'writer-eintr', 'final-range-eio',
      'range-einval', 'range-enosys', 'range-eopnotsupp',
      'directory-fsync', 'recovery-fsync', 'directory-open', 'cancel-before-write',
      'cancel-during-write', 'cancel-after-publish', 'cancel-before-delete',
      'long-name', 'broken-symlink', 'fifo-symlink', 'folder-copy', 'folder-move',
      'folder-unverified-copy', 'folder-native-merge', 'folder-existing-race',
      'folder-new-copy', 'folder-new-move', 'folder-parent-fsync', 'folder-partial-move',
      'merge-all', 'replace-all', 'rename-conflict', 'stage-collision',
      'cleanup-failure', 'file-over-folder', 'folder-over-file',
      'move-file-over-folder', 'move-folder-over-file',
      'fallback-file-over-folder', 'fallback-folder-over-file',
      'publish-directory-race', 'publish-directory-race-copy', 'folder-target-race',
      'nested-move-file-over-folder', 'nested-move-folder-over-file',
      'metadata-optional-absent', 'metadata-optional-absent-move', 'metadata-type-missing',
      'samefs-verified-move', 'empty-folder-copy', 'empty-folder-move',
      'conflict-skip', 'partial-conflict-copy', 'prescan-unreadable-file',
      'prescan-unreadable-folder', 'prescan-readdir-error', 'prescan-skip-then-cancel',
      'existing-identical', 'existing-empty', 'existing-mixed', 'existing-tree',
      'existing-different', 'existing-replace-all', 'existing-skip',
      'existing-repair-corrupt', 'existing-repair-write', 'existing-read-source',
      'existing-read-target', 'existing-cancel', 'existing-short-read',
      'existing-source-change', 'existing-target-change', 'existing-prompt-source',
      'existing-prompt-target', 'existing-repair-target-change', 'existing-no-version',
      'existing-symlink', 'existing-symlink-different', 'existing-regular-over-symlink',
      'existing-fifo', 'existing-unverified', 'existing-unverified-size-skip',
      'existing-merged-file-skip', 'existing-move-skip', 'existing-duplicate', 'existing-rename',
      'existing-unverified-tree', 'existing-partial-error', 'existing-source-inplace',
      'existing-target-inplace', 'existing-custom-name',
      'existing-no-version-size', 'existing-target-no-version-size', 'existing-link-over-unversioned',
    ]
      test('copy-integrity-' + scenario, hardening_python,
        args: hardening_runner + [copy_integrity, scenario],
        env: copy_integrity_base_env,
        depends: copy_integrity_schemas,
        suite: 'copy-integrity',
        protocol: 'tap',
        timeout: 30,
        is_parallel: false,
      )
    endforeach
  else
    warning('Copy integrity tests need dbus-run-session and xvfb-run')
  endif
endif
